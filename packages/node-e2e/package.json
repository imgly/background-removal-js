{
  "name": "e2e",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit/",
    "test:integration": "jest --testPathPattern=integration/",
    "test:performance": "jest --testPathPattern=performance/ --runInBand",
    "test:error": "jest --testPathPattern=error/",
    "test:browser": "playwright test",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:error",
    "test:ci": "jest --testPathPattern='unit|integration|error' --runInBand",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "workspace:*",
    "@playwright/test": "^1.40.0",
    "jest": "^29.6.2"
  },
  "version": "1.7.0"
}
